# ============================================================
# Reloop 环境变量模板 — 复制为 .env 后填写
# 接口只有三类: TTC 私域人才库(数据源) / 大模型(通用) / RDS MySQL(唯一数据库)
# 所有变量前缀 BRAINX_
# ============================================================

# ---------- RDS MySQL (唯一数据库) ----------
# 控制台「数据库连接」需申请外网地址(内网地址解析到 172.x 私网, 本地连不上);
# 外网地址形如 ttc-rds-public-xxxx.mysql.rds.aliyuncs.com, 并在白名单放通本机公网 IP
BRAINX_MYSQL_HOST=ttc-rds-public-0707.mysql.rds.aliyuncs.com   # 换成你的 RDS 外网地址
BRAINX_MYSQL_PORT=3306
BRAINX_MYSQL_USER=hayden
BRAINX_MYSQL_PASSWORD=Haydenmia2026
# 用独立库 reloop_app(避免与他人应用共库导致 recommendations 等表名冲突)
BRAINX_MYSQL_DATABASE=reloop_app
BRAINX_MYSQL_POOL_SIZE=10
BRAINX_MYSQL_CHARSET=utf8mb4
# 测试可覆盖为 SQLite(留空=用上面 MySQL): sqlite:///./test_reloop.db
BRAINX_DATABASE_URL=

# ---------- 大模型 (OpenAI 兼容通用接口) ----------
# 阿里云百炼兼容模式(默认); DeepSeek/OpenAI/本地 vLLM 换 BASE_URL 即可
BRAINX_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/coding
BRAINX_LLM_API_KEY=
BRAINX_LLM_MODEL=
BRAINX_LLM_EMBEDDING_MODEL=text-embedding-v3
BRAINX_LLM_TIMEOUT=30


# ---------- TTC 私域人才库 (数据源) ----------
# 人才库页面(浏览器): https://app.ttcadvisory.com/app/private-talent/talents/all-talents/<SPACE_ID>
# 数据接口网关(代码拉取用): https://gateway.ttcadvisory.com  <- 不是 app 子域
BRAINX_TTC_TALENT_BASE_URL=https://gateway.ttcadvisory.com
BRAINX_TTC_TALENT_SPACE_ID=U2034543869059211264
# 页面需飞书登录: F12 -> Network 复制请求 Authorization(填 Bearer token) 才真正拉取
BRAINX_TTC_TALENT_AUTH_TOKEN=
# 站点列表接口路径(按真实 XHR 补全)
BRAINX_TTC_TALENT_API_PATH=/api/private-talent/v1/all-talents

# ---------- 评分权重 (加权乘法模型: 触达优先级 = 活跃度^w1 × 匹配度^w2 × 价值^w3 × 关系^w4 × 倾向^w5) ----------
BRAINX_SCORE_W_ACTIVITY=0.3
BRAINX_SCORE_W_MATCH=0.4
BRAINX_SCORE_W_VALUE=0.15
BRAINX_SCORE_W_RELATION=0.1
BRAINX_SCORE_W_TENDENCY=0.05
# 低于该综合分的噪声候选人剔除
BRAINX_SCORE_NOISE_THRESHOLD=0.2
# TopN 的 N 值(Top3/Top10 之外的第3档)
BRAINX_RECOMMEND_TOP_N=10
# 活跃度牛顿冷却系数 λ
BRAINX_ACTIVITY_DECAY=0.1

# ---------- 应用 ----------
BRAINX_APP_ENV=dev
BRAINX_APP_PORT=8000
BRAINX_APP_LOG_LEVEL=INFO
# 是否强制飞书扫码登录态(X-Auth-Token)。生产= true(防任填隔离键伪造);
# 开发联调可临时设 false 以用 X-Owner-User-Id 直接指定隔离键。
BRAINX_AUTH_REQUIRE_TOKEN=true

# ---------- 飞书扫码登录(自建应用) ----------
# 开放平台 console.feishu.cn -> 应用 -> 凭证与基础信息; 留空则登录功能停用
BRAINX_FEISHU_APP_ID=
BRAINX_FEISHU_APP_SECRET=
# 登录态有效期(小时), 默认 168=7天
BRAINX_AUTH_SESSION_TTL_HOURS=168
# 注意: 应用的「重定向 URL」需在飞书开放平台配置, 如:
#   https://你的域名/#/auth/callback  和  http://localhost:8000/#/auth/callback

# ---------- 推荐缓存(两阶段计算) ----------
# 同(用户+岗位+JD+数据版本)结果缓存秒数, 默认 7 天; 人才库/互动变化自动失效
BRAINX_RECOMMEND_CACHE_TTL=604800
# 后台精算僵死判定秒数(超过则允许重新触发)
BRAINX_RECOMMEND_RUN_STALE_SECONDS=900
